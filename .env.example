# Memory module configuration — copy to .env (gitignored) and fill in.
# PINECONE_API_KEY is the only required value when using the default
# "pinecone" embedding backend.

PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX_NAME=agent-memory

# "pinecone" = Pinecone-hosted embeddings (recommended, one key only)
# "openai"   = bring-your-own embeddings (also set OPENAI_API_KEY)
EMBEDDING_BACKEND=pinecone
EMBEDDING_MODEL=llama-text-embed-v2
# EMBEDDING_DIMENSION=1536        # only used by the openai backend

PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Local JSON mirror of long-term memory (leave empty for the default location)
# MEMORY_DATA_DIR=

SHORT_TERM_WINDOW=20
MEMORY_TOP_K=3
# Minimum similarity to return a note — model-dependent:
# 0.2 suits llama-text-embed-v2, use ~0.7 for OpenAI embeddings.
MEMORY_MIN_SCORE=0.2

# Set to true (and provide ANTHROPIC_API_KEY) to extract facts with an LLM
# instead of the built-in heuristic rules.
TRIAGE_LLM=false
